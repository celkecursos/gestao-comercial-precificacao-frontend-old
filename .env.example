# URL base da API (backend NestJS), sem barra no final.
# Desenvolvimento local: http://localhost:3000
# Develop:  https://dev-api.celke.uno
# Homolog:  https://hml-api.celke.uno
# Produção: https://api.celke.uno
# Atenção: variáveis VITE_* são embutidas no build. Altere e gere um novo build para cada ambiente.
VITE_API_URL=http://localhost:3000

# ------------------------------------------------------------
# Testes e2e (Playwright) — lidos só pelo playwright.config.ts, nunca vão para o build.
# Os testes criam e EXCLUEM registros: use a API local ou a de develop, NUNCA produção.
# Valores abaixo: usuários do seed do backend (ver "Credenciais de demonstração" no README).
# ------------------------------------------------------------
E2E_ADMIN_EMAIL=cesar@celke.com.br
# Senha com # vai entre aspas — sem elas, o # vira comentário e a senha é cortada.
E2E_ADMIN_PASSWORD='123456A#b'
E2E_USER_EMAIL=kelly@celke.com.br
E2E_USER_PASSWORD='123456A#b'
# Opcional: testar um frontend já publicado em vez de subir o `npm run dev`.
# E2E_BASE_URL=http://localhost:5173
# Opcional: API usada na limpeza do dado de teste (padrão: VITE_API_URL).
# E2E_API_URL=http://localhost:3000
